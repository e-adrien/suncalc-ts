{
  "name": "suncalc-ts",
  "version": "3.1.1",
  "description": "A tiny JavaScript library for calculating sun/moon positions and phases.",
  "author": "Vladimir Agafonkin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e-adrien/suncalc-ts.git"
  },
  "homepage": "https://github.com/e-adrien/suncalc-ts#readme",
  "bugs": {
    "url": "https://github.com/e-adrien/suncalc-ts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "22.x || 24.x || 26.x"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "freshlock": "rm -rf node_modules/ && rm .yarn/install-state.gz && rm yarn.lock && yarn",
    "eslint-check": "eslint .",
    "eslint-fix": "eslint . --fix",
    "prettier-check": "prettier --check .",
    "prettier-fix": "prettier --write .",
    "test": "NODE_OPTIONS='--loader=ts-node/esm' mocha",
    "build": "tsc -p tsconfig.build.json"
  },
  "files": [
    "src/**/*",
    "dist/**/*"
  ],
  "keywords": [
    "sun",
    "astronomy",
    "math",
    "calculation",
    "sunrise",
    "sunset",
    "twilight",
    "moon",
    "illumination"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node22": "22.0.6",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "mocha": "11.8.0",
    "prettier": "3.9.10",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "packageManager": "yarn@4.18.1"
}
